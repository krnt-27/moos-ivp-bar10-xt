ServerHost = localhost
ServerPort = 9000

ProcessConfig = ANTLER
{
    MSBetweenLaunches = 200
    Run = MOOSDB @NewConsole = false
    Run = iBar10XT @NewConsole = false
}

ProcessConfig = iBar10XT
{
    AppTick       = 10
    CommsTick     = 10

    i2c_bus       = /dev/i2c-1
    i2c_addr      = 0x40
    fluid_density = 1029.0
}